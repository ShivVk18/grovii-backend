# Copy to .env and fill in real values. Never commit .env (it is in .gitignore).
# Only variables the code actually reads are listed here.

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grovii

# --- Auth (required) ---
# The API refuses to start if this is missing, shorter than 32 bytes, or a
# placeholder. Generate a fresh one for each environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs every user out (all existing tokens become invalid).
JWT_SECRET_KEY=
# Optional. Token lifetime in minutes, 1 to 43200. Default 10080 (7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM (required for generation): Google Gemini ---
GEMINI_API_KEY=
# Only for the optional image service (not used by the pipeline today).
OPENAI_API_KEY=

# --- Redis (rate limits, job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Cost and abuse limits (all optional; defaults shown) ---
# CREDITS_PER_GENERATION=1
# MAX_ACTIVE_JOBS_PER_USER=2
# ACTIVE_JOB_WINDOW_MINUTES=30
# RATE_GENERATE_PER_USER=10        # per hour
# RATE_GENERATE_PER_IP=30          # per hour
# RATE_LOGIN_PER_IP=10             # per minute
# RATE_LOGIN_PER_EMAIL=5           # per 15 minutes
# RATE_REGISTER_PER_IP=5           # per hour
# RATE_CREATE_PER_USER=30          # per minute
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# JOB_TOKEN_BUDGET=40000           # tokens per generation job
# DAILY_SPEND_LIMIT_USD=20         # all users combined, per UTC day
# LLM_PRICE_INPUT_PER_M=0.30       # USD per 1M tokens; check current Gemini prices
# LLM_PRICE_OUTPUT_PER_M=2.50

# --- ImageKit (optional, thumbnail/scene images) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Tests only ---
# Optional. Redis db for tests (never db 0). Default redis://localhost:6379/15
# TEST_REDIS_URL=redis://localhost:6379/15
# Optional. Defaults to DATABASE_URL with the database name replaced by
# grovii_test. The name must end in _test or the tests refuse to run.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grovii_test
