# Local staging secrets for deploy/docker-compose.yml. Copy to staging.env (git-ignored).
# Generate random values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
PROXY_SHARED_SECRET=
JWT_SECRET_KEY=
GEMINI_API_KEY=
APP_ENV=production
COOKIE_SECURE=false            # local staging is plain http; never set this on a real deploy
CORS_ORIGINS=http://localhost:3000
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
SENTRY_DSN=
