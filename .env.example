# Copy to .env and fill in real values. Never commit .env (it is in .gitignore).
# Only variables the code actually reads are listed here.

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grovii

# --- Auth (required) ---
# The API refuses to start if this is missing, shorter than 32 bytes, or a
# placeholder. Generate a fresh one for each environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs every user out (all existing tokens become invalid).
JWT_SECRET_KEY=
# Optional. Token lifetime in minutes, 1 to 43200. Default 10080 (7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM (required for generation) ---
OPENAI_API_KEY=

# --- ImageKit (optional, thumbnail/scene images) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Tests only ---
# Optional. Defaults to DATABASE_URL with the database name replaced by
# grovii_test. The name must end in _test or the tests refuse to run.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grovii_test
